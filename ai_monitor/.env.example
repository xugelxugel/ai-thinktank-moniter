# ============================================================
# AI 海外动态监测 · 云端运行环境变量模板
# 复制为 .env（本地调试）或在 GitHub Actions 中配置为 Secrets
# ============================================================

# ---- LLM 主供应商（Google Gemini 免费档）----
# 免费 Key 获取：https://aistudio.google.com/apikey
LLM_API_KEY=
# 以下三项可省略，使用默认值
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash

# ---- LLM 备用供应商（智谱 GLM-4-Flash，免费）----
# 注册：https://open.bigmodel.cn/  创建 API Key 后填入
# 不配置则不启用回退（主供应商故障时任务会失败）
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_FALLBACK_MODEL=glm-4-flash

# ---- Outlook SMTP 发信 ----
# 应用密码：account.microsoft.com → 安全 → 开启两步验证 → 生成 16 位应用密码
# 注意：不能用邮箱登录密码！若用 QQ 邮箱发信，改 SMTP_HOST=smtp.qq.com、
# SMTP_PORT=465，SMTP_PASS 填 16 位授权码
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 收件邮箱（默认与 SMTP_USER 相同，即自己发给自己）
MAIL_TO=xugelxugel@outlook.com

# ---- 可选调优 ----
# LLM_CONCURRENCY=4
# LLM_TIMEOUT=60
