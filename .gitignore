# WorkBuddy 内部数据（不需要入版本控制）
.workbuddy/

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb

# Virtual env
venv/
env/
.venv/

# 生成的简报产物（每次运行都会重新生成，体积大且非源代码）
ai_monitor/output/briefing_*.html
ai_monitor/output/briefing_*.md
ai_monitor/output/items_for_llm.json
ai_monitor/output/llm_analysis.json
ai_monitor/output/*.txt
# 例外：保留一个空的 .gitkeep
!ai_monitor/output/.gitkeep

# OS
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
.idea/
*.swp
*.swo
